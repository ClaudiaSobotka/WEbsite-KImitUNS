# Passwortschutz für die interne Vorschau (Apache 2.4+)
AuthType Basic
AuthName "KI.mit.UNS - interne Vorschau"
# WICHTIG: absoluten Serverpfad zur .htpasswd eintragen, siehe README-Hinweis
AuthUserFile /ABSOLUTER/SERVERPFAD/ZU/.htpasswd
Require valid-user

# .htpasswd selbst nie öffentlich ausliefern
<Files ".htpasswd">
    Require all denied
</Files>

